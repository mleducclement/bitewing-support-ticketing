### AGENT LOGIN
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "email": "skerrigan@bitewing.net",
  "password": "{{password}}"
}

### LEAD LOGIN
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "email": "amengsk@bitewing.net",
  "password": "{{password}}"
}

### LOGOUT
POST {{host}}/api/auth/logout
Content-Type: application/json

{}

### ME
GET {{host}}/api/auth/me

### CREATE TICKET
POST {{host}}/api/tickets
Content-Type: application/json

{
  "clinicName": "Maple Dental",
  "customerName": "Jordan Reyes",
  "customerEmail": "jordan@mapledental.example",
  "subject": "Cannot access booking calendar",
  "body": "Our front desk cannot see the calendar since this morning."
}

### CREATE TICKET - VALIDATION ERROR
POST {{host}}/api/tickets
Content-Type: application/json

{
  "clinicName": "Maple Dental",
  "customerName": "Jordan Reyes",
  "customerEmail": "not-an-email",
  "subject": "",
  "body": "Missing subject and bad email"
}

### CLAIM TICKET
# Log in first (AGENT LOGIN above), then replace {{ticketId}} with an id from CREATE TICKET
POST {{host}}/api/tickets/70bad7ca-00f7-4b8f-be6b-5c0b78808493/claim

### RELEASE TICKET
# Log in first (AGENT LOGIN above), then replace {{ticketId}} with a claimed ticket's id
POST {{host}}/api/tickets/70bad7ca-00f7-4b8f-be6b-5c0b78808493/release

### BLOCK TICKET
# Log in first (AGENT LOGIN above), then replace {{ticketId}} with a claimed ticket's id
POST {{host}}/api/tickets/70bad7ca-00f7-4b8f-be6b-5c0b78808493/block

### UNBLOCK TICKET
# Log in first (AGENT LOGIN above), then replace {{ticketId}} with a blocked ticket's id
POST {{host}}/api/tickets/70bad7ca-00f7-4b8f-be6b-5c0b78808493/unblock

### RESOLVE TICKET
# Log in first (AGENT LOGIN above), then replace {{ticketId}} with a claimed ticket's id
POST {{host}}/api/tickets/70bad7ca-00f7-4b8f-be6b-5c0b78808493/resolve

### GET ALL TICKETS
# Log in first (AGENT LOGIN above)
GET {{host}}/api/tickets

### GET TICKETS - FILTERED
# status: Open/InProgress/Blocked/Resolved/Cancelled
# priority: Low/Normal/Urgent
GET {{host}}/api/tickets?status=Open&priority=Urgent
